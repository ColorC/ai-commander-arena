# data root (README): scenario data, recordings, runs, models, assets, voices, music - never in the repo
/data/
__pycache__/
*.pyc
# built from the official Lua sources by fpc/native/build.sh (lua.exe for the script sandbox)
arena/sandbox/bin/
# the game's manuals as text (publisher's material): arena/library/fetch.py
arena/library/*.txt
arena/library/manifest.json
# third-party browser libraries (tools/video/fetch_vendor.py) and the font subset (tools/video/fetch_fonts.py)
tools/video/vendor/*
!tools/video/vendor/savepoint/
tools/video/vendor/savepoint/*.png
# generated by make_segment.py / compile_staging.py
tools/video/shot-*.js
tools/video/*.voice.json
tools/video/examples/shot-example.js
tools/video/examples/*.voice.json
tools/video/examples/*-timeline.md
tools/video/segments/
